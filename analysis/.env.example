# Set these in your shell (the code does not read a .env file). Never commit real values.
GEMINI_API_KEY=
VERITY_GEMINI_MODEL=
# Gemini Exchange account actions (optional). Use an Auditor key for reads, Trader only if orders are needed.
# Never use a key with the Fund Manager role (it can move funds).
GEMINI_EXCHANGE_API_KEY=
GEMINI_EXCHANGE_API_SECRET=
VERITY_EXCHANGE_ENV=sandbox
# VERITY_ALLOW_PRODUCTION=yes      # second switch required for production
# VERITY_TRADING_PAUSED=1          # stops every write immediately
