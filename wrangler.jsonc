{
  "name": "verity-research-api",
  "main": "research-worker.mjs",
  "account_id": "5721d456c33bef4cf9da9094b8a455ef",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "routes": [{ "pattern": "api.verityresearch.us", "custom_domain": true }],
  // Collection cron. It is not running until the next deploy of this Worker.
  "triggers": { "crons": ["*/2 * * * *"] },
  // Per-IP limits for the public API (namespaces unique in this account; 1021/1022 are the auth Worker's).
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1031", "simple": { "limit": 120, "period": 60 } },
    { "name": "API_HISTORY_LIMIT", "namespace_id": "1032", "simple": { "limit": 30, "period": 60 } }
  ],
  "hyperdrive": [
    { "binding": "VERITY_HISTORY_DB", "id": "4b4dfdd1a1534e60a19ed52a05039971" }
  ]
}
